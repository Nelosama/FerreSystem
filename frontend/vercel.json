{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "nexus/*": false,
      "fix/pilot-readiness": false,
      "codex/auditoria-precision-monetaria": false,
      "fix/inventario-inicial-seguro": false,
      "codex/fix-expired-sessions": false,
      "fix/jowa-operacion-estable": false,
      "codex/fix-camera-lifecycle-ios": false,
      "codex/estabilidad-operativa": false,
      "feat/contabilidad-honduras": false
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in nexus/*|fix/inventario-inicial-seguro|fix/pilot-readiness|codex/auditoria-precision-monetaria|codex/fix-expired-sessions|fix/jowa-operacion-estable|codex/fix-camera-lifecycle-ios|codex/estabilidad-operativa|feat/contabilidad-honduras) exit 0;; *) exit 1;; esac"
}
