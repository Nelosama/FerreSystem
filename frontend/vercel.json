{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/revision-seguridad-jowa-20261020": false,
      "nexus/*": false,
      "fix/pilot-readiness": false,
      "codex/auditoria-precision-monetaria": false,
      "fix/inventario-inicial-seguro": false,
      "codex/fix-expired-sessions": false,
      "fix/jowa-operacion-estable": false,
      "codex/fix-camera-lifecycle-ios": false,
      "codex/estabilidad-operativa": false
    }
  },
  "ignoreCommand": "sh scripts/vercel-ignore.sh"
}
