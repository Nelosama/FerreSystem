{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "nexus/*": false
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in nexus/*) exit 0;; *) exit 1;; esac"
}
