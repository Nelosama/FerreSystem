# ============================================================
# FerreSystem — Variables de entorno
# Copiar a .env y ajustar valores
# ============================================================

# Supabase PostgreSQL: pooled runtime URL and direct/session URL for Prisma CLI migrations.
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_SECRET="cambiar-por-un-secreto-seguro-de-al-menos-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Required only when creating the initial Super Admin with the seed command.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
TENANT_ADMIN_PASSWORD=
CONFIRM_SUPER_ADMIN_REPLACEMENT=
# Supabase Storage
SUPABASE_URL="https://[PROJECT_ID].supabase.co"
SUPABASE_SERVICE_KEY="eyJ..."

# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://your-project.vercel.app

