# ============================================================
# FerreSystem — Variables de entorno
# Copiar a .env y ajustar valores
# ============================================================

# Base de datos (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"
# Conexión directa para Prisma y herramientas: evitar el pooler para migraciones.
# Si DATABASE_URL ya es directa, DIRECT_URL puede usar esa misma conexión.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[DIRECT_HOST]:[PORT]/postgres"

# JWT: generar una clave privada aleatoria (por ejemplo: openssl rand -base64 48).
# Obligatoria fuera de development/test. No reutilizar claves de ejemplo ni publicarlas.
JWT_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Rotación del refresh token: segundos en que la cookie recién sustituida sigue valiendo (pestañas que renuevan a la vez,
# respuesta perdida). Opcional: 120 por defecto, máximo 600. Fuera de esa ventana, reutilizarla cierra la sesión.
# AUTH_REFRESH_GRACIA_SEGUNDOS="120"

# Contingencia offline: clave dedicada para derivar los identificadores de operación. Obligatoria (mínimo 32 caracteres),
# distinta de JWT_SECRET. Sin ella el backend no arranca (mensaje controlado, sin valores). No la reutilice entre entornos ni la publique.
# Detalle de inyección, rotación y transición: docs/CONTINGENCIA_CLAVE_OPERACIONES.md
CONTINGENCIA_CLAVE_OPERACIONES=""
# Solo durante la transición: clave que derivó las ventanas emitidas antes del cambio. Retirar cuando no queden
# operaciones offline pendientes de esas ventanas (las ventanas duran como máximo 36 horas).
CONTINGENCIA_CLAVE_OPERACIONES_ANTERIOR=""

# Required only when creating the initial Super Admin with the seed command.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
TENANT_ADMIN_PASSWORD=
CONFIRM_SUPER_ADMIN_REPLACEMENT=

# Logotipos privados: PostgreSQL cloud por defecto (requiere migraciones versionadas).
LOGOTIPO_ALMACEN=postgres
# Opcional: local requiere LOGOTIPO_DIRECTORIO absoluto sobre volumen persistente.
# Opcional: supabase requiere bucket privado y estas credenciales solo en backend.
# Supabase Storage
SUPABASE_URL="https://[PROJECT_ID].supabase.co"
SUPABASE_SERVICE_KEY="eyJ..."

# Servidor
PORT=3000
NODE_ENV=production
# Para desarrollo local HTTP usar NODE_ENV=development.

# CORS: EJEMPLOS de orígenes exactos; reemplazar por los despliegues reales.
# Lista separada por comas, solo orígenes HTTP(S), sin rutas, comodines ni credenciales.
# Configurar en Render y redeploy. No incluir consultas ni fragmentos.
# Los mismos orígenes autorizan login, refresh y logout: una petición con otro Origin recibe 403 (protección CSRF).
FRONTEND_URLS="https://ferre-system.vercel.app,https://ferre-system-git-codex-recuperacion-ventas-nelspace.vercel.app"
# Compatibilidad legacy: se conserva el origen individual junto con la lista.
FRONTEND_URL="https://ferre-system.vercel.app"

# Las cookies dependen de NODE_ENV: production usa Secure y SameSite=None.

# Recuperación (contraseña temporal por correo): solo backend, nunca variables VITE_. Ver docs/LOGIN_UNICO_RECUPERACION_20261026.md.
# El MFA se retiró del login: AUTH_MFA_ENCRYPTION_KEY ya no se necesita. Si existen secretos MFA heredados en la base
# (columnas mfa_* sin uso), conserve la clave respaldada hasta que se decida su eliminación documentada.
# Proveedor Resend: remitente/dominio verificado y API key restringida al envío.
AUTH_MAIL_RESEND_API_KEY=
AUTH_MAIL_FROM=
# Origen HTTPS fijo del frontend (no se usa Host de la petición para construir enlaces).
AUTH_PUBLIC_URL=
# Solo durante mantenimiento explícito, fuera de CI/startup. Dejar vacíos en despliegues.
AUTH_EMERGENCY_TICKET=
CONFIRM_SUPER_ADMIN_RECOVERY=
