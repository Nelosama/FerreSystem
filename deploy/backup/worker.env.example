# Copy OUTSIDE the repository; never commit real credentials or webhook URLs.
PGHOST=database.example.invalid
PGPORT=5432
PGDATABASE=ferresystem
PGUSER=backup_reader
PGSSLMODE=verify-full
PGCONNECT_TIMEOUT=15
RESTIC_REPOSITORY=s3:https://s3.example.invalid/separate-backup-bucket
# Provider credentials: inject via private env file or secret manager.
FERRE_BACKUP_INSTANCE=ferresystem-production
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_LAST=14
BACKUP_MAX_ATTEMPTS=3
BACKUP_RETRY_SECONDS=60
# HTTPS webhook routing only to technical Super Admin/on-call.
FERRE_BACKUP_ALERT_URL=
